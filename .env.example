# --------------------------------------------------------------------------
# Firebase — proyecto "Agua" (agua-19c50)
# --------------------------------------------------------------------------
# Estos valores NO son secretos: identifican la app ante Firebase y viajan
# dentro del navegador de todos modos. Quien protege los datos son las reglas
# de firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# La MISMA clave de arriba, pero sin el prefijo VITE_, para que las funciones
# de /api puedan comprobar quien esta llamando. Sin esto, cualquiera en
# internet podria usar nuestras rutas y gastarse el saldo.
FIREBASE_API_KEY=

# --------------------------------------------------------------------------
# DeepSeek — el chat con la mascota. ESTA CLAVE SI ES SECRETA.
# --------------------------------------------------------------------------
# Va SOLO aqui y en las variables de entorno de Vercel. Sin el prefijo VITE_,
# para que Vite nunca la meta en el paquete que descarga el navegador.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --------------------------------------------------------------------------
# Azure Speech — la VOZ de la mascota
# --------------------------------------------------------------------------
# Es el mismo recurso que usa Voz-Texto. Sin esto la app funciona igual, solo
# que en silencio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --------------------------------------------------------------------------
# Azure OpenAI — revisar la foto del vaso (OPCIONAL)
# --------------------------------------------------------------------------
# Si se deja vacio, la foto se guarda igual en el telefono pero sin revisar.
# Hay que desplegar un modelo que acepte imagenes en el recurso gemb-openai.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_VISION_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

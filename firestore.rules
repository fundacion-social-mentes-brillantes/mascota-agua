rules_version = '2';

// Mascota de Agua — reglas de seguridad.
//
// Regla unica y estricta: cada persona SOLO puede leer y escribir lo suyo.
// No hay ninguna coleccion publica ni compartida. Si manana se agrega algo
// compartido, se agrega su propio match con su propia condicion; nunca se
// abre esta.
service cloud.firestore {
  match /databases/{database}/documents {

    // El dueno del arbol es quien tiene ese uid, y tiene que estar conectado.
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // El perfil de la persona: nombre, edad, peso, altura, meta de agua.
    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      // Todo lo que cuelga del perfil (mascota, registros, dias, chat)
      // hereda la misma condicion.
      match /{documento=**} {
        allow read, write: if esDueno(uid);
      }
    }

    // Cualquier otra ruta queda cerrada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Mascota de Agua — reglas de seguridad.
//
// Regla base: cada persona SOLO puede leer y escribir lo suyo. No hay ninguna
// coleccion publica. La unica excepcion esta abajo, y esta acotada al hueso.
service cloud.firestore {
  match /databases/{database}/documents {

    // El dueno del arbol es quien tiene ese uid, y tiene que estar conectado.
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // La identidad tecnica que reparte los avisos de "tengo sed". No es una
    // persona: es el servidor. Se uso una cuenta robot y no una clave de
    // cuenta de servicio porque la organizacion las tiene prohibidas, y
    // porque asi el permiso queda mucho mas chiquito.
    function esRobotDeAvisos() {
      return request.auth != null && request.auth.uid == 'ESSJeXDWsOao5K0YcPHiJ3gHuKJ3';
    }

    // El perfil de la persona: nombre, edad, peso, altura, meta de agua.
    // Aqui el robot NO entra. Nunca ve el peso ni el IMC de nadie.
    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      match /{documento=**} {
        allow read, write: if esDueno(uid);
      }
    }

    // Lo MINIMO para poder mandar un aviso: a que telefono, a que hora
    // duerme, cuanta agua lleva y cuando fue el ultimo trago. Nada mas.
    match /avisos/{uid} {
      allow read, write: if esDueno(uid);

      // El robot puede mirar, pero no tocar...
      allow read: if esRobotDeAvisos();
      // ...salvo un solo campo: la marca de cuando aviso por ultima vez, que
      // es lo que evita que moleste dos veces seguidas.
      allow update: if esRobotDeAvisos()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAviso']);
    }

    // Contadores de uso del modelo, para el panel de la Fundacion.
    //
    // Aqui NADIE del lado del navegador entra: ni siquiera para leer lo suyo.
    // Los escribe el servidor despues de cada llamada a DeepSeek, y los lee
    // el servidor cuando el correo de la fundacion abre el panel. Si el
    // contador se pudiera tocar desde el telefono, no serviria para nada.
    //
    // Lo que cabe aqui son numeros de uso, el correo y el nombre publico.
    // Nunca peso, ni IMC, ni fotos, ni lo que la persona escribio.
    match /uso/{uid} {
      allow read, write: if esRobotDeAvisos();
    }

    // Cualquier otra ruta queda cerrada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
